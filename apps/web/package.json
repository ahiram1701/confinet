{
  "name": "@confinet/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "test": "vitest run",
    "build:static": "vite build --mode static",
    "e2e:static": "playwright test -c playwright.static.config.ts"
  },
  "dependencies": {
    "@confinet/core": "workspace:*",
    "@confinet/extract": "workspace:*",
    "@confinet/i18n": "workspace:*",
    "@confinet/llm": "workspace:*",
    "@confinet/ui": "workspace:*",
    "@heyputer/puter.js": "^2.6.5",
    "@tanstack/react-query": "^5.107.1",
    "better-auth": "^1.7.18",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "workbox-window": "^7.4.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261107.1",
    "@playwright/test": "^1.65.0",
    "@types/chrome": "^0.3.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "happy-dom": "^21.0.4",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
