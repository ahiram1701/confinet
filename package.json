    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "author": "Alberto Hiram Saucedo Guajardo",
  "homepage": "https://ahiram1701.github.io/confinet/",
  "repository": {
